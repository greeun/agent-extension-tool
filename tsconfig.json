{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["bun"],
    "paths": {
      "@core/*": ["./src/core/*"],
      "@cli/*": ["./src/cli/*"],
      "@tui/*": ["./src/tui/*"],
      "@pricing/*": ["./src/pricing/*"],
      "@config/*": ["./src/config/*"]
    }
  },
  "include": ["src/**/*", "bin/**/*", "tests/**/*"]
}
